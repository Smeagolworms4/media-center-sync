node_modules/
dist/
coverage/

# Build output, anchored to each package. An unanchored `build/` also matched
# `docker/build/`, which is where the production image lives — the Dockerfile was
# silently never committed, and the pipeline would have failed on a file that exists
# on every workstation.
/packages/*/build/
/build/
*.log
*.tsbuildinfo
junit.xml

# Local environment — never versioned: it holds machine addresses and secrets,
# not project ones.
.env.local
.env.*.local

# Tooling
docker/.makefiles/
docker/.*_history
docker/docker-compose.override.yml
.idea/
.vscode/
.DS_Store

# Test output
test-results/
playwright-report/

# Runtime data: SQLite file, transfers in flight
var/

# The gateway's own keypair, generated on first boot. It is the identity peers
# authenticate — committing it would hand anyone who cloned the repository the
# ability to impersonate this gateway to every friend it ever linked to.
packages/api/data/
*.pem
*.key
