# Default settings for the development stack.
#
# This file is versioned: it only holds development values. Anything specific to a
# machine — library mount points, service tokens, secrets — belongs in `.env.local`,
# which is not versioned. See `.env.local.example`.

COMPOSE_PROJECT_NAME=media-center-sync

FRONT_PORT=3200
API_PORT=4200
DEBUG_PORT=9230
PEER_PORT=4210

# Database engine. SQLite by default: one file, nothing to operate. `make db/postgres`
# switches the stack over; the migrations are the same either way.
DB_TYPE=sqlite
DB_FILE=var/media-center-sync.db

# Only read when DB_TYPE=postgres
DB_PORT=5433
DB_NAME=mcs
DB_USER=mcs
DB_PASSWORD=mcs

# Empty means in-memory cache. `make cache/redis` points it at the Redis container.
REDIS_HOST=
REDIS_PORT=6381

PGADMIN_PORT=7795
