{
	"name": "@mcs/api",
	"version": "0.1.0",
	"private": true,
	"description": "Sync gateway API \u2014 service handlers, correlation, transfers, peer links",
	"scripts": {
		"dev": "dotenv -e ../../.env -e ../../.env.local -- nest start --watch",
		"build": "nest build",
		"start": "node dist/main.js",
		"typecheck": "tsc --noEmit",
		"lint": "eslint src test --max-warnings 0",
		"lint:fix": "eslint src test --fix",
		"test": "jest --runInBand",
		"test:watch": "jest --runInBand --watch",
		"test:cov": "jest --runInBand --coverage",
		"seed": "dotenv -e ../../.env -e ../../.env.local -- ts-node -r tsconfig-paths/register src/commands/seed.ts",
		"library:check": "dotenv -e ../../.env -e ../../.env.local -- ts-node -r tsconfig-paths/register src/commands/library-check.ts",
		"service:list": "dotenv -e ../../.env -e ../../.env.local -- ts-node -r tsconfig-paths/register src/commands/service-list.ts",
		"service:probe": "dotenv -e ../../.env -e ../../.env.local -- ts-node -r tsconfig-paths/register src/commands/service-probe.ts",
		"service:scan": "dotenv -e ../../.env -e ../../.env.local -- ts-node -r tsconfig-paths/register src/commands/service-scan.ts",
		"peer:identity": "dotenv -e ../../.env -e ../../.env.local -- ts-node -r tsconfig-paths/register src/commands/peer-identity.ts",
		"peer:pull": "dotenv -e ../../.env -e ../../.env.local -- ts-node -r tsconfig-paths/register src/commands/peer-pull.ts",
		"migration:generate": "dotenv -e ../../.env -e ../../.env.local -- node -r ts-node/register -r tsconfig-paths/register $(node -p \"require.resolve('typeorm/cli.js')\") migration:generate -d src/database/data-source.ts",
		"migration:run": "dotenv -e ../../.env -e ../../.env.local -- node -r ts-node/register -r tsconfig-paths/register $(node -p \"require.resolve('typeorm/cli.js')\") migration:run -d src/database/data-source.ts",
		"migration:revert": "dotenv -e ../../.env -e ../../.env.local -- node -r ts-node/register -r tsconfig-paths/register $(node -p \"require.resolve('typeorm/cli.js')\") migration:revert -d src/database/data-source.ts",
		"lab:probe": "ts-node -r tsconfig-paths/register src/commands/lab-probe.ts"
	},
	"dependencies": {
		"@mcs/shared": "file:../shared",
		"@nestjs/common": "^11.0.0",
		"@nestjs/config": "^4.0.0",
		"@nestjs/core": "^11.0.0",
		"@nestjs/jwt": "^11.0.0",
		"@nestjs/passport": "^11.0.5",
		"@nestjs/platform-express": "^11.0.0",
		"@nestjs/platform-ws": "^11.0.0",
		"@nestjs/schedule": "^6.0.0",
		"@nestjs/serve-static": "^5.0.0",
		"@nestjs/swagger": "^11.0.0",
		"@nestjs/typeorm": "^11.0.0",
		"@nestjs/websockets": "^11.0.0",
		"bcryptjs": "^3.0.2",
		"better-sqlite3": "^12.11.1",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.2",
		"cron": "^3.5.0",
		"helmet": "^8.0.0",
		"ioredis": "^5.4.1",
		"passport": "^0.7.0",
		"passport-jwt": "^4.0.1",
		"pg": "^8.13.1",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.1",
		"typeorm": "^0.3.20",
		"ws": "^8.18.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.20.0",
		"@nestjs/cli": "^11.0.0",
		"@nestjs/schematics": "^11.0.0",
		"@nestjs/testing": "^11.0.0",
		"@types/bcryptjs": "^2.4.6",
		"@types/express": "^5.0.0",
		"@types/jest": "^29.5.14",
		"@types/node": "^22.10.0",
		"@types/passport-jwt": "^4.0.1",
		"@types/supertest": "^6.0.2",
		"@types/ws": "^8.5.13",
		"dotenv-cli": "^8.0.0",
		"eslint": "^9.20.0",
		"jest": "^29.7.0",
		"jest-junit": "^16.0.0",
		"supertest": "^7.0.0",
		"ts-jest": "^29.2.5",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.24.0"
	}
}
