{
	"name": "@mcs/front",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Sync gateway interface — Vue 3, Vuetify, Pinia",
	"scripts": {
		"dev": "dotenv -e ../../.env -e ../../.env.local -- vite --host 0.0.0.0",
		"build": "run-p type-check build-only",
		"build-only": "vite build",
		"preview": "vite preview",
		"type-check": "vue-tsc --build --force",
		"typecheck": "vue-tsc --build --force",
		"lint": "eslint . --max-warnings 0",
		"lint:fix": "eslint . --fix",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:cov": "vitest run --coverage",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"@fontsource/roboto": "^5.2.10",
		"@mcs/shared": "file:../shared",
		"@mdi/font": "7.4.47",
		"pinia": "^3.0.4",
		"vue": "^3.5.30",
		"vue-i18n": "^11.3.0",
		"vue-router": "^5.0.3",
		"vuetify": "^4.0.5"
	},
	"devDependencies": {
		"@playwright/test": "1.56.0",
		"@tsconfig/node22": "^22.0.5",
		"@types/node": "^24.12.0",
		"@vitejs/plugin-vue": "^6.0.5",
		"@vitest/coverage-v8": "^3.2.4",
		"@vue/test-utils": "^2.4.6",
		"@vue/tsconfig": "^0.9.0",
		"dotenv-cli": "^11.0.0",
		"eslint": "^9.39.4",
		"eslint-config-vuetify": "^4.3.4",
		"jsdom": "^26.1.0",
		"npm-run-all2": "^8.0.4",
		"resize-observer-polyfill": "^1.5.1",
		"sass-embedded": "^1.98.0",
		"typescript": "~5.9.3",
		"unplugin-fonts": "^1.4.0",
		"vite": "^8.0.0",
		"vite-plugin-vuetify": "^2.1.3",
		"vitest": "^3.2.4",
		"vue-tsc": "^3.2.5"
	},
	"overrides": {
		"unplugin-fonts": {
			"vite": "^8.0.0"
		}
	}
}
