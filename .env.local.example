# Copy this file to `.env.local` and fill in what is specific to your machine.
# `.env.local` is not versioned.

# Root under which media libraries are mounted, as seen from the gateway.
# It must point at the SAME files the media service sees, otherwise a file pulled
# here will never show up there. See `make library/help`.
#MCS_MEDIA_ROOT=/media

# Signs the sessions. A default would let anyone who read the repository mint a
# valid token, so production refuses to start without it.
#MCS_JWT_SECRET=

# Switch the database engine. `make db/postgres` writes these for you.
#DB_TYPE=postgres
#DB_HOST=db

# Move the live transfer state out of the process (only useful with several nodes).
#REDIS_HOST=cache
